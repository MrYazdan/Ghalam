# Maintainer: MrYazdan <ismryazdan@gmail.com>
pkgname=ghalam
pkgver=0.4.0
pkgrel=1
pkgdesc="Fast, elegant screen drawing & annotation tool for Linux (KDE Plasma, Wayland & X11)"
arch=('any')
url="https://github.com/MrYazdan/Ghalam"
license=('MIT')
depends=(
    'python'
    'python-pyqt6'
)
optdepends=(
    'spectacle: Fast background desktop capture on KDE Wayland'
)
makedepends=(
    'python-build'
    'python-installer'
    'python-wheel'
    'python-hatchling'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('db54f9d143096715b5b809d16277d2957a5d0f383a0fcbb9dc73a7f87e29cbf8')

build() {
    cd "$srcdir/$pkgname-$pkgver"
    python -m build --wheel --no-isolation
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    python -m installer --destdir="$pkgdir" dist/*.whl

    # Desktop entry
    install -Dm644 ghalam.desktop "$pkgdir/usr/share/applications/ghalam.desktop"

    # Application icons (full hicolor set)
    install -Dm644 assets/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/ghalam.svg"
    for size in 16 24 32 48 64 128 256 512; do
        install -Dm644 "assets/icons/ghalam-${size}.png" \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/ghalam.png"
    done

    # License
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
