# Maintainer: MrYazdan <ismryazdan@gmail.com>
pkgname=ghalam
pkgver=0.1.0
pkgrel=1
pkgdesc="Fast, elegant screen drawing & annotation tool for Linux (KDE Plasma, Wayland & X11)"
arch=('any')
url="https://github.com/mryazdan/ghalam"
license=('MIT')
depends=(
    'python'
    'python-pyqt6'
)
optdepends=(
    'spectacle: Fast background desktop capture on KDE Wayland'
)
makedepends=(
    'python-build'
    'python-installer'
    'python-wheel'
    'python-hatchling'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname-$pkgver"
    python -m build --wheel --no-isolation
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    python -m installer --destdir="$pkgdir" dist/*.whl

    # Desktop entry
    install -Dm644 ghalam.desktop "$pkgdir/usr/share/applications/ghalam.desktop"

    # Application icons
    install -Dm644 assets/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/ghalam.svg"
    install -Dm644 assets/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/ghalam.png"

    # License
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
